---
// Lab Layout (ticket 04 / ADR 0001): owns a lab page's entire document — head, fonts,
// ClientRouter, the standing band, the scene host, the status line. A lab page is ~10
// lines of props plus one mount call. Optional `player` reserves the player bar slot
// above the status line and the phase readout inside it (lab 02's reusable player).
import { ClientRouter } from 'astro:transitions';

interface Props {
	/** Two-digit lab number shown in the chip and the status line. */
	num: string;
	/** Lab name, poster-scale in the band. */
	name: string;
	/** Suffix metadata after the name; bind middots with `\u00A0·`. */
	suffix: string;
	/** Meta description for the head. */
	description: string;
	/** view-transition-name shared with the index row for the morph; defaults to `lab-<n>`. */
	label?: string;
	/** Source link target; defaults to the repo. */
	sourceUrl?: string;
	/** Reserve the player bar slot and the phase readout. */
	player?: boolean;
}

const { num, name, suffix, description, label, sourceUrl = 'https://github.com/daniheras', player = false } = Astro.props;
const vtName = label ?? `lab-${Number(num)}`;
const ghLabel = sourceUrl === 'https://github.com/daniheras' ? 'source ↗' : 'source ↗';
---


<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0b0908" />
		<title>{name} — pixijs-3d-labs</title>
		<ClientRouter />
	</head>
	<body>
		<header class="band" style={`view-transition-name: ${vtName};`}>
			<span class="chip" aria-hidden="true">{num}</span>
			<h1 class="name">{name}</h1>
			<span class="suffix" set:html={suffix} />
			<span class="cursor" aria-hidden="true"></span>
			<nav class="nav">
				<a href="/">← index</a>
				<a href={sourceUrl} rel="noopener noreferrer">{ghLabel}</a>
			</nav>
		</header>

		<main class="stage" id="stage" data-lab-stage aria-label={`${name} — live 3D scene`}></main>

		<div class="player-slot" data-lab-player-slot></div>

		<footer class="status">
			<span>lab: {Number(num)} · status: beta</span>
			<span data-lab-backend>backend: resolving</span>
			{player && <span class="phase" data-lab-phase hidden></span>}
			<span class="sp"></span>
			<a class="gh" href={sourceUrl} rel="noopener noreferrer">github ↗</a>
		</footer>
	</body>

	<style>
		@font-face {
			font-family: 'JetBrains Mono';
			font-style: normal;
			font-weight: 100 800;
			font-display: swap;
			src: url('/fonts/jetbrains-mono-var.woff2') format('woff2');
		}

		:root {
			--bg: #0b0908;
			--red: #e5483c;
			--red-bright: #ff5f4d;
			--fg: #d8cfc7;
			--fg-dim: #8a7e76;
			--border: #2a1f1a;
			--ease-out: cubic-bezier(0.23, 1, 0.32, 1);
			color-scheme: dark;
		}

		* {
			box-sizing: border-box;
			margin: 0;
		}

		a {
			text-decoration: none;
			color: inherit;
		}

		html,
		body {
			height: 100%;
		}

		body {
			background: var(--bg);
			color: var(--fg);
			font-family: 'JetBrains Mono', ui-monospace, 'DejaVu Sans Mono', 'Liberation Mono', monospace;
			font-size: 16px;
			line-height: 1.6;
			display: flex;
			flex-direction: column;
			min-height: 100vh;
			overflow-x: clip;
		}

		::selection {
			background: var(--red);
			color: #0b0908;
		}

		/* the standing row: full-bleed inverse band */
		.band {
			flex: none;
			display: flex;
			align-items: center;
			gap: 36px;
			padding: 30px 48px;
			background: var(--red);
			flex-wrap: wrap;
		}
		.band .chip {
			flex-shrink: 0;
			width: clamp(52px, 6vw, 76px);
			height: clamp(52px, 6vw, 76px);
			background: #0b0908;
			color: var(--red-bright);
			display: grid;
			place-items: center;
			font-size: clamp(20px, 2.2vw, 28px);
			font-weight: 700;
		}
		.band .name {
			font-size: clamp(36px, 5.5vw, 72px);
			font-weight: 700;
			letter-spacing: -0.035em;
			line-height: 1;
			color: #0b0908;
		}
		.band .suffix {
			font-size: 15px;
			color: rgba(11, 9, 8, 0.92);
		}
		.band .cursor {
			width: 0.55em;
			height: 1em;
			margin-left: 1ch;
			background: #0b0908;
			animation: blink 1.1s steps(1) infinite;
			align-self: center;
		}
		@keyframes blink {
			50% {
				opacity: 0;
			}
		}
		.band .nav {
			margin-left: auto;
			display: flex;
			gap: 3ch;
			font-size: 13px;
		}
		.band .nav a,
		.band .gh {
			color: #0b0908;
			transition: opacity 0.15s ease;
		}
		.band .nav a:hover,
		.band .gh:hover {
			opacity: 0.72;
		}
		.band a:focus-visible {
			outline: 1px dashed #0b0908;
			outline-offset: 4px;
		}
		.status a:focus-visible {
			outline: 1px dashed var(--red);
			outline-offset: 4px;
		}

		/* the scene floats on the clean ground — no frame, no canvas chrome */
		.stage {
			flex: 1;
			min-height: 0;
			position: relative;
		}
		.stage :global(canvas) {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			display: block;
			touch-action: none;
		}
		.stage :global([data-lab-failure]) {
			position: absolute;
			inset: 0;
			display: grid;
			place-items: center;
			font-size: 13px;
			color: var(--fg-dim);
			text-align: center;
			padding: 0 22px;
		}

		/* the player bar slot: empty and zero-footprint until the player mounts into it */
		.player-slot:empty {
			display: none;
		}

		/* status line */
		.status {
			flex: none;
			display: flex;
			gap: 3ch;
			align-items: center;
			border-top: 1px solid var(--border);
			padding: 14px 48px 18px;
			font-size: 13px;
			color: var(--fg-dim);
			position: relative;
			z-index: 1;
			flex-wrap: wrap;
		}
		.status .sp {
			flex: 1;
		}
		.status .phase {
			color: var(--fg-dim);
		}
		.status .phase[data-live] {
			color: var(--red);
		}

		/* the one authored moment on direct load; skipped when arriving via view transition */
		.band,
		.status {
			opacity: 0;
			transform: translateY(8px);
			animation: enter 360ms var(--ease-out) forwards;
		}
		.status {
			animation-delay: 90ms;
		}
		.stage {
			opacity: 0;
			animation: enter-fade 500ms var(--ease-out) 180ms forwards;
		}
		@keyframes enter {
			to {
				opacity: 1;
				transform: translateY(0);
			}
		}
		@keyframes enter-fade {
			to {
				opacity: 1;
			}
		}
		@media (prefers-reduced-motion: reduce) {
			.band,
			.status,
			.stage {
				animation-duration: 0.2s;
				animation-delay: 0ms !important;
			}
			.band,
			.status {
				transform: none;
			}
			.cursor {
				animation: none;
			}
		}
		html.swapped .band,
		html.swapped .status,
		html.swapped .stage {
			animation: none !important;
			opacity: 1 !important;
			transform: none !important;
		}

		/* small screens */
		@media (max-width: 720px) {
			.band {
				gap: 18px;
				padding: 18px 22px;
			}
			.band .suffix {
				font-size: 12px;
			}
			.band .nav {
				margin-left: 0;
				flex-basis: 100%;
			}
			.status {
				padding-left: 22px;
				padding-right: 22px;
			}
		}
	</style>

	<style is:global>
		/* shared-element morph: the clicked index row becomes the standing band */
		::view-transition-group(*) {
			animation-duration: 360ms;
			animation-timing-function: cubic-bezier(0.23, 1, 0.32, 1);
		}
		@media (prefers-reduced-motion: reduce) {
			::view-transition-group(*),
			::view-transition-image-pair(*),
			::view-transition-old(*),
			::view-transition-new(*) {
				animation: none !important;
			}
		}
	</style>

	<script>
		// arriving via view transition: the morph carries the entrance, so skip it
		document.addEventListener('astro:after-swap', () => {
			document.documentElement.classList.add('swapped');
		});
	</script>
</html>
