---
// Landing — Editorial Mono Index, bolder (direction contract in .impeccable/surfaces/src-pages-index-astro.md)
const labs = [
	{
		num: '01',
		slug: 'hello-cube',
		name: 'hello-cube',
		suffix: '3d\u00A0· view3d\u00A0· beta',
		href: '/labs/hello-cube/',
	},
	{
		num: '02',
		slug: '2d3d-hybrid',
		name: '2d3d-hybrid',
		suffix: '2d+3d\u00A0· view3d\u00A0+\u00A02d\u00A0· beta',
		href: '/labs/2d3d-hybrid/',
	},
];
const githubUrl = 'https://github.com/daniheras';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Two hands-on labs into the closed PixiJS 3D beta — 3D scenes and 2D+3D hybrids, one route per lab. Source open." />
		<meta name="theme-color" content="#0b0908" />
		<title>pixijs-3d-labs — hands-on labs for the PixiJS 3D beta</title>
	</head>
	<body>
		<span class="ghost" aria-hidden="true">3D</span>

		<header class="bar">
			<a class="wordmark" href="/">pixijs-<span class="d3">3d</span>-labs</a>
		</header>

		<p class="intro">
			Two labs into the closed <span class="lit">@pixi/3d</span> beta — small, self-contained,
			one route each. Rendered webgpu-first, fallback webgl. Source open.
		</p>

		<main class="index">
			<h1 class="sr-only">pixijs-3d-labs — hands-on labs for the PixiJS 3D beta</h1>
			{
				labs.map((lab, i) => (
					<a class:list={['row', { demo: i === labs.length - 1 }]} style={`animation-delay: ${60 + i * 60}ms`} href={lab.href} data-row={i}>
						<span class="num" aria-hidden="true">{lab.num}</span>
						<h2 class="name">{lab.name}</h2>
						<span class="suffix">{lab.suffix}</span>
						<span class="cursor" aria-hidden="true"></span>
					</a>
				))
			}
		</main>

		<footer class="status">
			<span>labs: 2 · status: beta</span>
			<span class="hint">↵ open</span>
			<span class="sp"></span>
			<a class="gh" href={githubUrl} rel="noopener noreferrer">github ↗</a>
		</footer>
	</body>

	<style>
		@font-face {
			font-family: 'JetBrains Mono';
			font-style: normal;
			font-weight: 100 800;
			font-display: swap;
			src: url('/fonts/jetbrains-mono-var.woff2') format('woff2');
		}

		:root {
			--bg: #0b0908;
			--red: #e5483c;
			--red-bright: #ff5f4d;
			--red-dim: #7c2f24;
			--fg: #d8cfc7;
			--fg-dim: #8a7e76;
			--border: #2a1f1a;
			--ease-out: cubic-bezier(0.23, 1, 0.32, 1);
			color-scheme: dark;
		}

		* {
			box-sizing: border-box;
			margin: 0;
		}

		a {
			text-decoration: none;
			color: inherit;
		}

		html,
		body {
			height: 100%;
		}

		body {
			background: var(--bg);
			color: var(--fg);
			font-family: 'JetBrains Mono', ui-monospace, 'DejaVu Sans Mono', 'Liberation Mono', monospace;
			font-size: 16px;
			line-height: 1.6;
			display: flex;
			flex-direction: column;
			min-height: 100vh;
			overflow-x: clip;
		}

		::selection {
			background: var(--red);
			color: #0b0908;
		}

		a:focus-visible {
			outline: 1px dashed var(--red);
			outline-offset: 4px;
		}

		.sr-only {
			position: absolute;
			width: 1px;
			height: 1px;
			padding: 0;
			margin: -1px;
			overflow: hidden;
			clip: rect(0 0 0 0);
			white-space: nowrap;
			border: 0;
		}

		/* ghost watermark */
		.ghost {
			position: fixed;
			right: -0.05em;
			top: 90px;
			font-size: clamp(180px, 30vw, 400px);
			font-weight: 800;
			line-height: 1;
			letter-spacing: -0.05em;
			color: transparent;
			-webkit-text-stroke: 1px rgba(229, 72, 60, 0.14);
			pointer-events: none;
			user-select: none;
			z-index: 0;
		}

		/* top bar */
		.bar {
			display: flex;
			align-items: center;
			padding: 30px 48px 0;
			font-size: 15px;
			position: relative;
			z-index: 1;
		}
		.wordmark {
			font-weight: 700;
			letter-spacing: -0.02em;
		}
		.d3 {
			color: var(--red);
		}
		.gh {
			margin-left: auto;
			color: var(--fg-dim);
			font-size: 13px;
			transition: color 0.15s ease;
		}
		.gh:hover {
			color: var(--red-bright);
		}

		/* intro */
		.intro {
			padding: 44px 48px 0;
			max-width: 62ch;
			color: var(--fg-dim);
			font-size: 15px;
			line-height: 1.75;
			position: relative;
			z-index: 1;
		}
		.intro .lit {
			color: var(--fg);
		}

		/* the index — the poster moment */
		.index {
			margin: auto 0;
			position: relative;
			z-index: 1;
		}
		.row {
			display: flex;
			align-items: center;
			gap: 36px;
			padding: 26px 48px;
			transition: background 0.15s ease;
		}
		.row .num {
			flex-shrink: 0;
			width: clamp(56px, 6vw, 84px);
			height: clamp(56px, 6vw, 84px);
			background: var(--red);
			color: #0b0908;
			display: grid;
			place-items: center;
			font-size: clamp(22px, 2.4vw, 32px);
			font-weight: 700;
			transition:
				background 0.15s ease,
				color 0.15s ease,
				transform 140ms var(--ease-out);
		}
		.row:active .num {
			transform: scale(0.94);
		}
		.row .name {
			font-size: clamp(44px, 7.5vw, 92px);
			font-weight: 700;
			letter-spacing: -0.035em;
			line-height: 1;
			color: var(--fg);
			transition:
				color 0.15s ease,
				opacity 140ms var(--ease-out);
		}
		.row:active .name {
			opacity: 0.85;
		}
		.row .suffix {
			font-size: 16px;
			color: var(--fg-dim);
			margin-left: 8px;
			transition: color 0.15s ease;
		}

		/* inverted state: standing on the last row, on hover (fine pointers only) and focus */
		.row:focus-visible,
		.row.demo {
			background: var(--red);
		}
		.row:focus-visible .num,
		.row.demo .num {
			background: #0b0908;
			color: var(--red-bright);
		}
		.row:focus-visible .name,
		.row.demo .name {
			color: #0b0908;
		}
		.row:focus-visible .suffix,
		.row.demo .suffix {
			color: rgba(11, 9, 8, 0.92);
		}
		@media (hover: hover) and (pointer: fine) {
			.row:hover {
				background: var(--red);
			}
			.row:hover .num {
				background: #0b0908;
				color: var(--red-bright);
			}
			.row:hover .name {
				color: #0b0908;
			}
			.row:hover .suffix {
				color: rgba(11, 9, 8, 0.92);
			}
		}

		/* cursor */
		/* cursor: one per row, shown only on the active (demo) row */
		.cursor {
			display: none;
			width: 0.55em;
			height: 1em;
			margin-left: 1ch;
			background: var(--red);
			animation: blink 1.1s steps(1) infinite;
		}
		.demo .cursor {
			display: inline-block;
			background: #0b0908;
		}
		@keyframes blink {
			50% {
				opacity: 0;
			}
		}

		/* the one authored moment: staggered entrance, poster reads top to bottom */
		.intro,
		.row,
		.status {
			opacity: 0;
			transform: translateY(8px);
			animation: enter 360ms var(--ease-out) forwards;
		}
		.status {
			animation-delay: 180ms;
		}
		.ghost {
			opacity: 0;
			animation: enter-fade 500ms var(--ease-out) 180ms forwards;
		}
		@keyframes enter {
			to {
				opacity: 1;
				transform: translateY(0);
			}
		}
		@keyframes enter-fade {
			to {
				opacity: 1;
			}
		}
		@media (prefers-reduced-motion: reduce) {
			.intro,
			.row,
			.status,
			.ghost {
				animation-duration: 0.2s;
				animation-delay: 0ms !important;
			}
			.intro,
			.row,
			.status {
				transform: none;
			}
			.cursor {
				animation: none;
			}
		}

		/* status line */
		.status {
			display: flex;
			gap: 3ch;
			align-items: center;
			border-top: 1px solid var(--border);
			padding: 14px 48px 18px;
			font-size: 13px;
			color: var(--fg-dim);
			position: relative;
			z-index: 1;
			flex-wrap: wrap;
		}
		.status .sp {
			flex: 1;
		}
		.status .cursor {
			width: 1ch;
			height: 1em;
		}

		/* small screens */
		@media (max-width: 720px) {
			.bar,
			.intro,
			.status {
				padding-left: 22px;
				padding-right: 22px;
			}
			.intro {
				padding-top: 30px;
				font-size: 14px;
			}
			.row {
				gap: 18px;
				padding: 18px 22px;
			}
			.row .suffix {
				font-size: 12px;
			}
			.ghost {
				top: auto;
				bottom: 40px;
			}
			.status .hint {
				display: none;
			}
		}
	</style>
</html>

<script>
	// Arrow keys move the standing inversion (and real focus) across the index
	// rows, cycling infinitely. Enter then opens the focused lab natively.
	const rows = [...document.querySelectorAll<HTMLAnchorElement>('a.row')];

	function focusRow(index: number) {
		const row = rows[(index + rows.length) % rows.length];
		for (const r of rows) r.classList.remove('demo');
		row.classList.add('demo');
		row.focus();
	}

	document.addEventListener('keydown', (e) => {
		const t = document.activeElement;
		if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || (t as HTMLElement).isContentEditable)) {
			return;
		}
		if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;

		const current = rows.findIndex((r) => r.classList.contains('demo'));
		const delta = e.key === 'ArrowDown' ? 1 : -1;
		focusRow((current === -1 ? 0 : current) + delta);
		e.preventDefault();
	});
</script>
